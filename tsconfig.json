{
  // Node runs the .ts files directly by stripping the types ("type stripping"),
  // so TypeScript is only used here to check types (noEmit). That is why imports
  // end in ".ts" and why only "erasable" syntax is allowed (no enums, no namespaces).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"]
}
